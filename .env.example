# Email Triage Bot — every setting the bot reads, with safe defaults.
#
# Copy to .env.local (gitignored) and fill in. Nothing real belongs in this
# file: it is committed. On the cluster these values come from the
# `email-triage-secrets` entry of the Nature secrets file, not from a file
# like this one.
#
#   cp .env.example .env.local
#   git status --short --ignored .env.local   # expect: ignored, not untracked
#
# The canonical table, with types and semantics, is docs/design.md.

# ---- Input files ------------------------------------------------------------
# On the cluster both are mounted from Secrets. Locally, point them at files
# outside the repo (the repo gitignores rules.yaml and accounts.yaml anyway).
RULES_FILE=/config/rules.yaml
ACCOUNTS_FILE=/config/accounts.yaml

# ---- Behaviour --------------------------------------------------------------
# Default true everywhere. Nothing in a mailbox changes until this is false.
# `run --dry-run=false` overrides it.
DRY_RUN=true

# Only consider messages received within this many days.
LOOKBACK_DAYS=7

# Hard cap per account per run, newest first.
MAX_MESSAGES_PER_ACCOUNT=200

# Characters of stripped body kept for the Judge. This is the single biggest
# lever on how much of your mail leaves the network.
BODY_MAX_CHARS=2000

# Audit Labels. Applied to every judged message so a person can review the
# run in the mail client and so the next run skips it. Clearing them in the
# mail client resets the bot for those messages.
LABEL_READ=Triage/Read
LABEL_LEFT=Triage/Left

# ---- Judge ------------------------------------------------------------------
# gemini | openai | none   ("none" disables the Brand tier entirely, so the bot
# runs deterministic rules only and nothing leaves the network.)
JUDGE_PROVIDER=gemini

# Candidates per Judge call.
JUDGE_BATCH_SIZE=10

# Ceiling across all accounts in one run. Candidates beyond it fail closed
# (Verdict leave) rather than costing more quota.
JUDGE_MAX_CALLS_PER_RUN=100

# Per-call timeout. A timeout fails that batch closed.
JUDGE_TIMEOUT=60s

# --- gemini ---
# Required when JUDGE_PROVIDER=gemini. Use a key from a BILLING-LINKED Google
# Cloud project (Tier 1): on the free tier Google's terms allow your prompts —
# which contain your mail — to be used for training. See docs/adr/0002.
GEMINI_API_KEY=REPLACE-WITH-YOUR-GEMINI-API-KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# --- openai-compatible ---
# Required when JUDGE_PROVIDER=openai. Any chat-completions endpoint:
#   http://ollama:11434/v1            (local Ollama — nothing leaves the LAN)
#   https://api.groq.com/openai/v1    (hosted)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Gmail ------------------------------------------------------------------
# One OAuth desktop client, shared by every account. The per-account refresh
# tokens live in the accounts file, not here.
GMAIL_CLIENT_ID=123456789012-example.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=REPLACE-WITH-YOUR-CLIENT-SECRET

# ---- Reporting --------------------------------------------------------------
# Both set enables a per-run summary message. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GET this URL after a fully successful run (dead-man's switch). Empty disables.
HEALTHCHECK_PING_URL=

# Write a Decision Log (JSONL) here. `run --decisions-out` overrides. Empty
# disables. Never point this into a repository: it is mail metadata.
DECISIONS_OUT=

# ---- Logging ----------------------------------------------------------------
# json for the cluster (Alloy ships it to Loki), text for a readable terminal.
LOG_FORMAT=text
LOG_LEVEL=info
